# ============================================================
# TidalTwin - Frontend Environment (TEMPLATE)
# ============================================================
# Copy this file to `.env.local` for local development:
#     copy .env.example .env.local     (Windows)
#     cp   .env.example .env.local     (macOS / Linux)
#
# `.env.local` is gitignored. This template IS committed and must
# never contain a real token. Safe placeholders only.
# ============================================================

# --- Backend API base URL (optional) -----------------------------
# Leave EMPTY when the app is served behind the same origin as the
# backend (the Docker/nginx setup). For local `npm run dev` against a
# backend on port 8000, keep the default below.
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Cesium Ion token (optional) ---------------------------------
# Enables Cesium Ion terrain / imagery. The globe still renders
# from bundled assets without it. Obtain your own token from
# https://ion.cesium.com/tokens and paste it here (never commit it).
VITE_CESIUM_ION_TOKEN=

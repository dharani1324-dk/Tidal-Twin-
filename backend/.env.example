# ============================================================
# TidalTwin - Backend Environment (TEMPLATE)
# ============================================================
# Copy this file to `.env` and fill in your real values:
#     copy .env.example .env        (Windows)
#     cp   .env.example .env        (macOS / Linux)
#
# `.env` is gitignored. This template IS committed and must never
# contain a real password, key or token. Safe placeholders only.
# ============================================================

# --- Database (REQUIRED) -----------------------------------------
# PostgreSQL + PostGIS connection string used by all data-backed features.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# NOTE: URL-encode special characters in the password, e.g.
#       "@" -> "%40", ":" -> "%3A", "/" -> "%2F".
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/tidaltwin

# --- Backend bind address (optional) -----------------------------
# Where the API listens when started directly with uvicorn.
# Docker sets these itself, so they are optional in a container.
API_HOST=127.0.0.1
API_PORT=8000

# --- Runtime environment (optional) ------------------------------
# "development" (default) or "production".
# In production, localhost database URLs trigger a startup warning.
ENVIRONMENT=development

# --- CORS (optional) ---------------------------------------------
# Comma-separated list of allowed frontend origins.
# "*" is the permissive default so the local demo works out of the box;
# set an explicit list (e.g. http://localhost:8080) for any deployment.
CORS_ORIGINS=*

# --- Cesium Ion token (optional) ---------------------------------
# Only needed for Cesium Ion terrain / high-resolution imagery.
# The 3D globe loads from bundled assets and works without it.
# Leave empty to run in the optional/unavailable state.
CESIUM_ION_TOKEN=

# --- TIDE read-cache TTL (optional) ------------------------------
# Seconds the expensive TIDE shared inputs are cached in-process.
# Longer = more responsive demo; shorter = fresher data. 0 disables it.
TIDE_CACHE_TTL_SECONDS=120

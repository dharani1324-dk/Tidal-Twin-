# OceanVerse AI - Environment Settings (Template)
# Copy this file to `.env` and fill in your real values.
# The `.env` file is NOT committed to Git. This template IS.

# Database connection details
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# NOTE: If your password has special characters (@ : / etc), URL-encode them.
#       e.g. "@" becomes "%40", ":" becomes "%3A"
# Example: postgres:MyP@ss -> postgres:MyP%40ss
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/oceanverse

# Backend
API_HOST=127.0.0.1
API_PORT=8000
